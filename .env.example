# ============================================================
#  MONAD ARB BOT - ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your values
#  NEVER share your .env file or commit it to GitHub
# ============================================================

# Your wallet private key (with 0x prefix)
# Get this from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=

# Monad RPC endpoint
# Public RPC (free, slower): https://rpc.monad.xyz
# Private RPC (faster): Get from https://alchemy.com or https://quicknode.com
RPC_URL=https://monad-mainnet.g.alchemy.com/v2/MJFBTpz_frRtmqM5GrKb3

# ============================================================
#  TRADING SETTINGS
# ============================================================

# PAPER_TRADE=false  → Bot finds opportunities but does NOT spend money (safe mode)
# PAPER_TRADE=false → Bot executes REAL trades with REAL money
PAPER_TRADE=false

# Minimum profit in USD to trigger a trade (ignore tiny opportunities)
MIN_PROFIT_USD=0.50

# Maximum amount to trade per opportunity (in MON tokens)
MAX_TRADE_AMOUNT_MON=30

# Slippage tolerance (0.5 = 0.5%)
SLIPPAGE_PERCENT=0.5

# How often to scan for opportunities (in milliseconds)
# 1000 = every 1 second, 3000 = every 3 seconds
SCAN_INTERVAL_MS=2000
